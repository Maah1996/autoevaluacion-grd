rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // correo autorizado a crearse a sí mismo como primer administrador
    function bootstrapEmail() { return 'marcoaraya1973@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function uDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && uDoc().activo == true;
    }
    function isAdmin() { return isActive() && uDoc().rol == 'admin'; }

    // ---- usuarios ----
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // el admin da de alta a cualquiera; además, el correo de bootstrap puede
      // crear UNA sola vez su propio doc de administrador (arranque del sistema).
      allow create: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.auth.token.email == bootstrapEmail()
            && request.resource.data.rol == 'admin'
            && request.resource.data.activo == true);

      allow update, delete: if isAdmin();
    }

    // ---- empresas ----
    match /empresas/{empresaId} {
      function nombreValido() {
        let nombre = request.resource.data.get('nombre', null);
        return nombre is string && nombre.trim().size() > 0;
      }
      allow read: if isActive();
      allow create: if isActive() && nombreValido();
      // Permite cerrar auditorías antiguas cuando solo se actualiza el resumen.
      allow update: if isActive() && (
        nombreValido()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaAuditoria', 'actualizado'])
      );
      allow delete: if isAdmin();

      // ---- auditorías de la empresa ----
      match /auditorias/{audId} {
        function planValido() {
          let plan = request.resource.data.get('brechas', null);
          return plan is map
            && plan.get('filas', null) is map
            && plan.get('antecedentes', {}) is map
            && plan.get('manualIds', []) is list;
        }
        allow read: if isActive();
        // La evaluación se crea en blanco. Las respuestas se guardan al editar.
        allow create: if isActive()
          && request.resource.data.estado == 'borrador'
          && request.resource.data.respuestas is map
          && request.resource.data.respuestas.size() == 0
          && !('seguimiento' in request.resource.data)
          && !('seguimientoItem' in request.resource.data)
          && (!('brechas' in request.resource.data) || planValido());

        function cambioPermitido() {
          let campos = request.resource.data.diff(resource.data).affectedKeys();
          return (!campos.hasAny(['brechas']) || planValido())
            && (resource.data.estado != 'cerrada'
                || campos.hasOnly(['brechas','fecha','evaluadorNombre','obs','actualizado']));
        }
        function texto(value, maximum) {
          return value is string && value.trim().size() > 0 && value.size() <= maximum;
        }
        function seguimientoValido() {
          let n = request.resource.data.seguimientoItem;
          let previous = resource.data.get('seguimiento', {});
          let next = request.resource.data.seguimiento;
          let old = previous.get(n, {'version': 0, 'historial': {}});
          let entry = next[n];
          let data = entry.actual;
          return resource.data.estado in ['borrador', 'cerrada']
            && n is string && n.matches('^([1-9]|[1-4][0-9]|5[0-6])$')
            && resource.data.respuestas.get(n, '') == 'no'
            && next is map && next.diff(previous).affectedKeys().hasOnly([n])
            && entry.keys().hasOnly(['version', 'actual', 'historial'])
            && entry.version == old.version + 1
            && entry.historial is map
            && ((old.version == 0 && entry.historial.size() == 0)
              || (old.version > 0
                && entry.historial.diff(old.historial).affectedKeys().hasOnly([string(old.version)])
                && entry.historial.size() == old.historial.size() + 1
                && entry.historial[string(old.version)] == old.actual))
            && data.keys().hasOnly(['estado', 'solucion', 'fechaSolucion', 'responsable', 'evidencia',
              'fechaVerificacion', 'verificador', 'actorUid', 'actorNombre', 'registrado'])
            && data.estado in ['informada', 'verificada']
            && texto(data.solucion, 4000) && texto(data.responsable, 200)
            && texto(data.evidencia, 4000) && texto(data.actorNombre, 200)
            && data.actorUid == request.auth.uid && data.registrado == request.time
            && data.fechaSolucion is string && data.fechaSolucion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
            && data.fechaSolucion >= resource.data.fecha
            && ((data.estado == 'informada' && data.fechaVerificacion == '' && data.verificador == '')
              || (data.estado == 'verificada' && texto(data.verificador, 200)
                && data.fechaVerificacion.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                && data.fechaVerificacion >= data.fechaSolucion));
        }
        allow update: if isActive() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seguimiento', 'seguimientoItem', 'actualizado'])
            && seguimientoValido())
          || (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['seguimiento', 'seguimientoItem'])
            && cambioPermitido())
        );
        allow delete: if isAdmin();
      }
    }
  }
}
