rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // correo autorizado a crearse a sí mismo como primer administrador
    function bootstrapEmail() { return 'marcoaraya1973@gmail.com'; }

    function signedIn() { return request.auth != null; }
    function uDoc() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function isActive() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && uDoc().activo == true;
    }
    function isAdmin() { return isActive() && uDoc().rol == 'admin'; }

    // ---- usuarios ----
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());

      // el admin da de alta a cualquiera; además, el correo de bootstrap puede
      // crear UNA sola vez su propio doc de administrador (arranque del sistema).
      allow create: if isAdmin()
        || (signedIn()
            && request.auth.uid == uid
            && request.auth.token.email == bootstrapEmail()
            && request.resource.data.rol == 'admin'
            && request.resource.data.activo == true);

      allow update, delete: if isAdmin();
    }

    // ---- empresas ----
    match /empresas/{empresaId} {
      function nombreValido() {
        let nombre = request.resource.data.get('nombre', null);
        return nombre is string && nombre.trim().size() > 0;
      }
      allow read: if isActive();
      allow create: if isActive() && nombreValido();
      // Permite cerrar auditorías antiguas cuando solo se actualiza el resumen.
      allow update: if isActive() && (
        nombreValido()
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimaAuditoria', 'actualizado'])
      );
      allow delete: if isAdmin();

      // ---- auditorías de la empresa ----
      match /auditorias/{audId} {
        function planValido() {
          let plan = request.resource.data.get('brechas', null);
          return plan is map
            && plan.get('filas', null) is map
            && plan.get('antecedentes', {}) is map
            && plan.get('manualIds', []) is list;
        }
        allow read: if isActive();
        allow create: if isActive()
          && (!('brechas' in request.resource.data) || planValido());

        function cambioPermitido() {
          let campos = request.resource.data.diff(resource.data).affectedKeys();
          return (!campos.hasAny(['brechas']) || planValido())
            && (resource.data.estado != 'cerrada'
                || isAdmin()
                || campos.hasOnly(['brechas']));
        }
        allow update: if isActive() && cambioPermitido();
        allow delete: if isAdmin();
      }
    }
  }
}
