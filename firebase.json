{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "prev-riegos",
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, max-age=0, must-revalidate" }
        ]
      }
    ],
    "ignore": [
      "!(index.html)",
      "*/**/*",
      "**/.*",
      "**/.*/**"
    ]
  }
}
